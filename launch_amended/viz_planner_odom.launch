<launch>
  <!-- 规划轨迹演示：不影响 EGO 的 odom_topic -->
  <arg name="script_dir" default="$(env UAV_REPO)"/>
  <!-- 未设置 UAV_REPO 时在本机仓库根目录执行: python poscmd_to_viz_odom.py -->

  <node pkg="odom_visualization" name="viz_planner_mesh" type="odom_visualization" output="screen">
    <remap from="~odom" to="/viz/odom"/>
    <param name="frame_id" value="world"/>
    <param name="robot_scale" value="1.6"/>
    <param name="color/r" value="0.95"/>
    <param name="color/g" value="0.15"/>
    <param name="color/b" value="0.75"/>
    <param name="color/a" value="0.9"/>
  </node>
</launch>